# Soft IP 主诉评估系统 环境配置模板
# 复制为 .env 后修改

# 运行模式：默认真实 Demo；开发调试可切到 Mock
USE_MOCK=False

# DeepSeek API 配置（USE_MOCK=False 时必填）
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 外部检索服务配置（真实模式下建议填写；未填写则对应检索链路会自动跳过）
QCC_API_TOKEN=your_qcc_token_here
PKULAW_API_TOKEN=your_pkulaw_token_here
